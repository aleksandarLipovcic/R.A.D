# Visual Studio Build Folders
.vs/
x64/
Debug/
Release/
*.user
*.aps
*.pcc

# Python temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/

# YOLO/Machine Learning weights (too big for GitHub)
*.pt
*.onnx
# ...except the released detection model, versioned on purpose
# (GitHub limit: 100 MB per file; a yolo26m best.pt is ~40-45 MB)
!YOLO26M model/*.pt

# Test results
TestResults/
IMUTests/
**/junitresults_*.xml

# Datasets (raw data, too large for GitHub)
DroneCockpitUI/datasets/
DroneCockpitUI/NNTraining/datasets/
*.zip
*.npy
*.tif
*.tiff

# Training run outputs
DroneCockpitUI/NNTraining/runs/
runs/

# Runtime-generated caches and outputs (regenerated on demand, never
# source). Paths are repo-root-relative, matching the
# DroneCockpitUI/... entries above -- the repo root is the
# "Project R.A.D" folder, so these resolve to the same two folders
# without hardcoding anyone's Desktop path.
DroneCockpitUI/tile_cache/
DroneCockpitUI/detections/

# VRAM diagnostics / profiling artifacts
*vram_snapshot.pickle
*vram_trace.csv
/DroneCockpitUI/NNTraining/handoff